// Signing settings shared by every target.
//
// Put your own Apple Developer team in App/Local.xcconfig, which git ignores:
//   cp App/Local.xcconfig.example App/Local.xcconfig
// Set the team there rather than under Signing & Capabilities, so it stays out of project.pbxproj.

DEVELOPMENT_TEAM =

// The app uses this bundle ID and the embedded CLI uses it plus ".cli". A bundle ID belongs to one team,
// so builds signed with another team override it in Local.xcconfig.
PUSHWRIGHT_BUNDLE_ID = com.openingax.pushwright

#include? "Local.xcconfig"
